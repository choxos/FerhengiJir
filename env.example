# Firebase Configuration (client) — copy to .env
# These are NOT secrets: the Firebase web apiKey identifies the project and is
# safe to ship in the browser. Access is controlled by Firestore rules + App Check.
# Get these values from your Firebase project console.
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Optional: Firebase Analytics. Leave empty to disable (no-op without it).
# REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase App Check via reCAPTCHA v3. When set, the client attaches an
# App Check token to every /api request. The server only REJECTS missing tokens
# when you also set the APP_CHECK_ENFORCE param on the function (see SECURITY.md).
# REACT_APP_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Optional: base URL of the Gemini proxy for LOCAL DEVELOPMENT only.
# In production the app calls /api/* same-origin via a Firebase Hosting rewrite,
# so leave this empty. For the local emulator, point it at the functions host.
# REACT_APP_API_BASE=

# IMPORTANT: The Gemini API key is NO LONGER a client variable.
# It now lives only on the server. Set it as a Firebase secret:
#   firebase functions:secrets:set GEMINI_API_KEY
# Do NOT put REACT_APP_GEMINI_API_KEY anywhere — anything REACT_APP_* is bundled
# into the public JS and would leak (that is how the key leaked before).

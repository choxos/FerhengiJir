# Production build flags (committed; safe, no secrets).
# CRA inlines the webpack runtime as an inline <script> by default, which the
# strict Content-Security-Policy (script-src 'self') would block. Emit it as an
# external file instead so the CSP can stay tight.
INLINE_RUNTIME_CHUNK=false

# Don't ship source maps publicly (smaller deploy, less code exposure).
GENERATE_SOURCEMAP=false
